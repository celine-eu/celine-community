# Deployment posture (celine.sdk.posture). Only `dev` relaxes: it accepts the local
# defaults below (database password, client secret == client id, local Keycloak) and
# allows DEV_AUTH_ENABLED. Unset, or any other value (staging, prod, ...), is hardened:
# those defaults refuse to start and a missing policy engine fails closed.
# `task run` exports CELINE_ENV=dev already. ENVIRONMENT is still read as a fallback.
CELINE_ENV=dev
DEV_AUTH_ENABLED=false
# Which branch of the access policy the development fixture exercises:
#   manager — an organization-scoped manager of one REC
#   admin   — a `platform-admin` realm-role holder, who sees every REC the registry lists
DEV_USER_PROFILE=manager
AGGREGATE_CACHE_TTL_SECONDS=30

DATABASE_URL=postgresql+asyncpg://postgres:securepassword123@host.docker.internal:15432/celine_community
CELINE_OIDC_BASE_URL=http://keycloak.celine.localhost/realms/celine
CELINE_OIDC_JWKS_URI=http://keycloak.celine.localhost/realms/celine/protocol/openid-connect/certs
CELINE_OIDC_AUDIENCE=svc-community
CELINE_OIDC_CLIENT_ID=svc-community
CELINE_OIDC_CLIENT_SECRET=svc-community

DIGITAL_TWIN_API_URL=http://host.docker.internal:8002
DIGITAL_TWIN_SCOPE=digital-twin.values.read dataset.query
REC_REGISTRY_URL=http://host.docker.internal:8004
REC_REGISTRY_SCOPE=rec-registry.read
# The optional scope svc-community asks for only when a manager attaches or detaches a
# meter; never part of the default token. Empty turns the meter action off.
REC_REGISTRY_ASSETS_WRITE_SCOPE=rec-registry.assets.write
# The optional scope svc-community asks for only when a manager corrects a member's role
# or area; never part of the default token. Empty turns the edit action off.
REC_REGISTRY_PROFILE_WRITE_SCOPE=rec-registry.members.profile.write
FLEXIBILITY_API_URL=http://host.docker.internal:8017
NUDGING_API_URL=http://host.docker.internal:8016
NUDGING_SCOPE=nudging.analytics.read
WEBAPP_API_URL=http://host.docker.internal:8014
ROI_API_URL=http://host.docker.internal:8018
# Onboarding sends member invitations and password resets for this dashboard. It has no
# default, since it is an internal address. Unset, the send buttons are not offered.
# ONBOARDING_URL=http://host.docker.internal:8040
# The optional scope svc-community asks onboarding's token for (celine-policies clients.yaml).
ONBOARDING_SCOPE=onboarding.members.invite
# Asked for only when a REC admin releases a member (another optional scope of svc-community).
# Empty turns the release action off.
ONBOARDING_RELEASE_SCOPE=onboarding.members.release
CELINE_POLICIES_DIR=./policies
